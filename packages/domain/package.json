{
  "name": "@koi/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Koi's pure domain core: dependency-free, deterministic, engine-agnostic (V8 == JSC == Hermes byte-identical, Spike C / D-030).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "conformance": "node scripts/run-conformance.mjs node",
    "conformance:ci": "node scripts/run-conformance.mjs node hermes",
    "conformance:all": "node scripts/run-conformance.mjs node jsc hermes"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}

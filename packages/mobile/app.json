{
  "expo": {
    "name": "Koi",
    "slug": "koi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "koi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tv.titanos.koi",
      "supportsTablet": false,
      "associatedDomains": [
        "webcredentials:koi-dev.gariasf.com?mode=developer"
      ]
    },
    "android": {
      "package": "tv.titanos.koi"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

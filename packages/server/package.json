{
  "name": "@koi/server",
  "version": "0.1.0",
  "private": true,
  "description": "Koi sync server: Fastify 5 + zod + Drizzle bespoke write-path API (D-022/D-025). Accept-with-2xx, per-column base_version protocol (S-5/D-023), exhaustive op-handling with dead-lettering. better-auth mounted in-process: passkey-primary, recovery codes, no email (D-025, Build Session 6).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:sync": "vitest run --config vitest.sync.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:generate:auth": "better-auth generate --config src/auth/cli-instance.ts --output src/db/auth-schema.ts -y",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@koi/domain": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^9.20.0",
    "@powersync/node": "0.20.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "better-sqlite3": "^12.11.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
